# ==============================================================================
# NagarWatch - AI & Intelligence Environment Variables (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local environment:
#      copy .env.example .env
# 2. Populate the actual credentials below.
# 3. NEVER commit your actual '.env' file or secret keys to version control.
# ==============================================================================

# Google Gemini API Key (Required for live Gemini operations)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name (Configurable, defaults to gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# API Request Timeout in seconds (Float, defaults to 30.0)
GEMINI_TIMEOUT_SECONDS=30.0

# Maximum retry attempts on transient network or rate-limit errors
GEMINI_MAX_RETRIES=3

# CARTO Basemaps API Key (For Leaflet Positron raster tiles)
# Obtain from: https://carto.com/basemaps/apikey/
CARTO_API_KEY=YOUR_CARTO_API_KEY
